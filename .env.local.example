# Agenda VPS (preferencial) — proxy nginx /api em produção
VITE_API_URL=http://localhost:8787/api

# Legado Supabase (só se VITE_API_URL estiver vazio)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Videochamada = WebRTC nativo (sinalização em /api/rtc). Sem Jitsi.

# Spotify — use o Client ID do dashboard (não commite secrets)
# Dashboard: https://developer.spotify.com/dashboard
# VITE_SPOTIFY_CLIENT_ID=
# Redirect: https://www.vintagedevstack.com.br/callback
# (dev: http://localhost:5173/callback)

# Opcional: playlist Spotify no Embed (spotify:playlist:ID)
# VITE_SPOTIFY_PLAYLIST_URI=spotify:playlist:37i9dQZF1DX1s9knjP51Oa
