# Copie para .env na VPS (NÃO commitar o .env real)
# Gere valores fortes: openssl rand -hex 24

POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_EMAIL=admin@vintagedevstack.com.br
ADMIN_PASSWORD=
ADMIN_NAME=Marcos Padilha
PUBLIC_SITE_URL=https://www.vintagedevstack.com.br
# Video = WebRTC P2P no próprio site (sem Jitsi).
# Opcional: TURN self-hosted na VPS, ex.:
# ICE_SERVERS=[{"urls":"turn:216.22.27.191:3478","username":"vintage","credential":"..."}]
ICE_SERVERS=[]
# 8080 = Workana no host; Vintage usa 8090 só em loopback
HTTP_PORT=8090
VITE_API_URL=/api

