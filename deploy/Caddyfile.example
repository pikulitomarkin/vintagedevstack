# Blocos para colar em /opt/clube/Caddyfile e /opt/clube/src/Caddyfile
# (fonte de verdade do Caddy compartilhado). Depois: docker exec clube-caddy-1 caddy reload --config /etc/caddy/Caddyfile
#
# DNS: aponte A de www/apex para 216.22.27.191 antes do TLS (Let's Encrypt).

www.vintagedevstack.com.br, vintagedevstack.com.br {
	encode gzip
	reverse_proxy vintage-web-1:80
}
