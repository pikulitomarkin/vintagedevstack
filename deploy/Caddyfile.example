# Cole em /opt/clube/Caddyfile e /opt/clube/src/Caddyfile (fonte de verdade).
# Só ative DEPOIS de apontar DNS A de www + apex para 216.22.27.191
# (enquanto apontar para Vercel, o ACME/Let's Encrypt falha e gera rate-limit).
#
# Depois: docker exec clube-caddy-1 caddy reload --config /etc/caddy/Caddyfile

www.vintagedevstack.com.br, vintagedevstack.com.br {
	encode gzip
	reverse_proxy vintage-web-1:80
}
